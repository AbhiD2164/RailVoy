# ── Dependency directories (ALL nesting levels) ────────────────────────────────
node_modules/
**/node_modules/

# ── Build / compile outputs ────────────────────────────────────────────────────
dist/
build/
**/dist/
**/build/

# ── Python cache & virtualenvs ─────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
**/.venv/

# ── Environment variables & secrets (NEVER commit keys) ───────────────────────
.env
.env.local
.env.production
.env.*.local
**/.env
**/.env.local
**/.env.production

# ── Runtime data files (wallet balances, live transaction logs) ────────────────
# These are managed at runtime by RailVoy-Pay & RailVoy-Accounts services.
# Seed files (accounts.json, users.json) live inside each service's repo.
RailVoy-Pay/backend/data/users.json
RailVoy-Pay/backend/data/transactions.json
RailVoy-Accounts/backend/data/accounts.json

# ── Large dataset files ────────────────────────────────────────────────────────
RailVoy/dataset/
dataset/

# ── Logs ───────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS & editor artifacts ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
